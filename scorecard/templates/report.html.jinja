<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ project_name }} - Security Scorecard</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; line-height: 1.6; color: #24292e; max-width: 1000px; margin: 0 auto; padding: 20px; }
        h1 { border-bottom: 1px solid #eaecef; padding-bottom: .3em; }
        table { border-collapse: collapse; width: 100%; margin-top: 20px; }
        th, td { border: 1px solid #dfe2e5; padding: 12px; text-align: left; }
        th { background-color: #f6f8fa; }
        .severity-Critical { background-color: #ffeef0; color: #d73a49; font-weight: bold; }
        .severity-High { background-color: #fff5ed; color: #f66a0a; font-weight: bold; }
        .severity-Medium { background-color: #fffbdd; color: #b08800; font-weight: bold; }
        .severity-Low { background-color: #dcffe4; color: #28a745; font-weight: bold; }
        .score-badge { display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 14px; background: #e1e4e8; }
    </style>
</head>
<body>
    <h1>Security Scorecard</h1>
    <p>Project: <strong>{{ project_name }}</strong></p>
    
    <table>
        <thead>
            <tr>
                <th>Finding</th>
                <th style="width: 100px; text-align: center;">Score</th>
                <th style="width: 150px;">Severity</th>
            </tr>
        </thead>
        <tbody>
            {% for res in results %}
            <tr>
                <td>{{ res.finding }}</td>
                <td style="text-align: center;"><span class="score-badge">{{ res.score }}</span></td>
                <td class="severity-{{ res.severity }}">{{ res.color }} {{ res.severity }}</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    
    <div style="margin-top: 40px; font-size: 12px; color: #6a737d;">
        Generated by DXD Labs Senior Agent Scorecard Tool
    </div>
</body>
</html>
